# ─────────────────────────────────────────
# Neon PostgreSQL (obtener en neon.tech)
# ─────────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/preparaoss?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/preparaoss?sslmode=require"

# ─────────────────────────────────────────
# Clerk Auth (obtener en clerk.com)
# ─────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
CLERK_WEBHOOK_SECRET=whsec_xxxx

# ─────────────────────────────────────────
# Groq (obtener en console.groq.com)
# ─────────────────────────────────────────
GROQ_API_KEY=gsk_xxxx

# ─────────────────────────────────────────
# Upstash Redis (obtener en upstash.com)
# ─────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx

# ─────────────────────────────────────────
# Cron Jobs (clave para proteger endpoints /api/cron/*)
# ─────────────────────────────────────────
CRON_SECRET=una-clave-secreta-aleatoria-32-chars

# ─────────────────────────────────────────
# App Config
# ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PreparaOss
