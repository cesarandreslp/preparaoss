# ─────────────────────────────────────────
# Neon PostgreSQL  →  neon.tech → tu proyecto → Connection string
# Usa la URL con ?pgbouncer=true para Vercel serverless
# ─────────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# ─────────────────────────────────────────
# Clerk Auth →  clerk.com → tu aplicación → API Keys
# En producción usa pk_live_* y sk_live_*
# Añadir el dominio Vercel en Clerk: Settings → Domains
# Para el webhook (opcional): Clerk → Webhooks → Añadir endpoint /api/webhooks/clerk
# ─────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
CLERK_WEBHOOK_SECRET=whsec_xxxx

# ─────────────────────────────────────────
# Groq →  console.groq.com → API Keys
# ─────────────────────────────────────────
GROQ_API_KEY=gsk_xxxx

# ─────────────────────────────────────────
# Upstash Redis →  upstash.com → Create Database → REST API
# Usado para rate limiting. Opcional si no se usan ligas/rankings en tiempo real.
# ─────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx

# ─────────────────────────────────────────
# Cron Jobs →  genera con: openssl rand -base64 32
# Vercel envía este valor como Authorization: Bearer <CRON_SECRET>
# ─────────────────────────────────────────
CRON_SECRET=genera-un-string-aleatorio-seguro-aqui

# ─────────────────────────────────────────
# App Config  →  cambiar por tu dominio Vercel tras el deploy
# ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://tu-proyecto.vercel.app
NEXT_PUBLIC_APP_NAME=PreparaOss
