// PreparaOss — Schema Prisma completo
// Neon PostgreSQL + Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────

enum TipoPregunta {
  FUNCIONAL_ESPECIFICA  // Juicio situacional: escenario + 3 preguntas, 3 opciones c/u
  FUNCIONAL_TRANSVERSAL // Pregunta directa con 4 opciones
  COMPORTAMENTAL        // Escala Likert 1-5 según nivel de responsabilidad
}

enum NivelDificultad {
  BASICO
  INTERMEDIO
  AVANZADO
}

enum TipoSimulacro {
  FUNCIONAL_ESPECIFICA
  FUNCIONAL_TRANSVERSAL
  COMPORTAMENTAL
  MIXTO
}

enum EstadoSimulacro {
  EN_PROGRESO
  COMPLETADO
  ABANDONADO
}

enum PlanSuscripcion {
  GRATUITO  // 3 simulacros/mes, 10 preguntas
  BASICO    // 10 simulacros/mes, 20 preguntas
  PRO       // ilimitado, 40 preguntas, desafíos
  PREMIUM   // todo + simulacros históricos oficiales
}

enum EstadoSuscripcion {
  ACTIVA
  VENCIDA
  CANCELADA
}

enum TipoBadge {
  RACHA
  SIMULACROS
  PRECISION
  SOCIAL
  ESPECIAL
}

enum EstadoOpec {
  ACTIVA
  CERRADA
  VENCIDA
}

enum Rol {
  USUARIO
  ADMIN
}

enum DocumentType {
  MANUAL_FUNCIONES
  GUIA_ORIENTACION
  EJES_TEMATICOS
  DOCUMENTO_ENTIDAD
  OTHER
}

// ─────────────────────────────────────────────────────────
// OPEC — Oferta Pública de Empleo de Carrera
// ─────────────────────────────────────────────────────────

model Opec {
  id               String     @id @default(cuid())
  simoId           String     @unique // ID interno de SIMO/CNSC
  numerConvocatoria String?
  nombreCargo      String
  entidad          String
  nivelJerarquico  String     // Profesional, Técnico, Auxiliar, Directivo, etc.
  grado            String
  numVacantes      Int
  municipio        String
  departamento     String
  
  requisitosEstudio String    @db.Text
  requisitosExp     String    @db.Text
  competencias      String[]  // Lista de competencias evaluadas
  tipoPruebas       String[]  // ["Conocimientos", "Competencias", "Psicotécnica"]
  
  // Nivel de responsabilidad del cargo (impacta Likert comportamental)
  // 1=Auxiliar 2=Técnico 3=Profesional 4=Asesor 5=Directivo
  nivelResponsabilidad Int    @default(3)
  
  asignacionBasica      Int?       // Asignación básica mensual en COP (estimada según tabla salarial)
  fechaLimiteInscripcion DateTime?
  fechaExamen            DateTime?
  estado                 EstadoOpec @default(ACTIVA)
  
  // Metadatos scraping
  urlDetalle       String?
  scrapedAt        DateTime   @default(now())
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  escenarios       EscenarioSituacional[]
  preguntas        Pregunta[]
  simulacros       Simulacro[]
  inscripciones    UserOpec[]
  rankings         Ranking[]
  documentos       Document[]

  @@index([estado, departamento])
  @@index([entidad])
}

// ─────────────────────────────────────────────────────────
// PREGUNTAS — 3 tipos según CNSC
// ─────────────────────────────────────────────────────────

/// Escenario de juicio situacional (≥10 líneas)
/// Del cual se desprenden 3 preguntas FUNCIONAL_ESPECIFICA
model EscenarioSituacional {
  id        String     @id @default(cuid())
  contenido String     @db.Text // Párrafo de mínimo 10 líneas
  opecId    String
  opec      Opec       @relation(fields: [opecId], references: [id], onDelete: Cascade)
  preguntas Pregunta[]
  createdAt DateTime   @default(now())

  @@index([opecId])
}

model Pregunta {
  id       String       @id @default(cuid())
  tipo     TipoPregunta
  texto    String       @db.Text

  // Solo para FUNCIONAL_ESPECIFICA — referencia al escenario padre
  escenarioId String?
  escenario   EscenarioSituacional? @relation(fields: [escenarioId], references: [id], onDelete: SetNull)

  // opecId: solo para FUNCIONAL_ESPECIFICA (preguntas atadas al cargo
  // específico). FUNCIONAL_TRANSVERSAL y COMPORTAMENTAL viven en pools
  // globales y NO pertenecen a una OPEC — su opecId es null y se
  // identifican por poolKey.
  opecId   String?
  opec     Opec?        @relation(fields: [opecId], references: [id], onDelete: Cascade)

  // Pool al que pertenece la pregunta (solo si opecId es null):
  // - "TRANSVERSAL_GLOBAL" → normatividad/gestión pública compartida
  // - "COMPORT_NIVEL_1".."COMPORT_NIVEL_5" → Likert por nivel
  poolKey  String?

  opciones OpcionRespuesta[]

  // Categoría temática (Normatividad, Gestión Pública, etc.)
  categoria  String
  dificultad NivelDificultad @default(INTERMEDIO)

  // Explicación/retroalimentación generada por IA (se muestra AL FINAL del simulacro)
  explicacion String @db.Text

  // Para preguntas COMPORTAMENTAL: nivel del cargo (1-5) con que fue generada
  nivelResponsabilidad Int?

  // Control de calidad
  validada Boolean @default(false)
  reportes Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  respuestas RespuestaUsuario[]

  @@index([opecId, tipo])
  @@index([tipo, validada])
  @@index([poolKey, tipo]) // muestreo rápido al armar simulacro
}

model OpcionRespuesta {
  id         String   @id @default(cuid())
  preguntaId String
  pregunta   Pregunta @relation(fields: [preguntaId], references: [id], onDelete: Cascade)

  // FUNCIONAL_ESPECIFICA: "A", "B", "C"
  // FUNCIONAL_TRANSVERSAL: "A", "B", "C", "D"
  // COMPORTAMENTAL: "1", "2", "3", "4", "5"
  letra      String
  texto      String   @db.Text
  esCorrecta Boolean

  // Para COMPORTAMENTAL: valor Likert ponderado según nivelResponsabilidad
  valorLikert Int?

  respuestas RespuestaUsuario[]

  @@index([preguntaId])
}

// ─────────────────────────────────────────────────────────
// USUARIO
// ─────────────────────────────────────────────────────────

model UserProfile {
  id           String @id @default(cuid())
  email        String @unique
  nombre       String
  passwordHash String
  rol          Rol    @default(USUARIO)

  // Gamificación
  xpTotal          Int      @default(0)
  nivel            Int      @default(1) // 1=Principiante … 5=Élite
  rachaActual      Int      @default(0) // días consecutivos
  rachaMasLarga    Int      @default(0)
  ultimaActividad  DateTime?
  simulacrosMesActual Int   @default(0)
  mesContador      String?  // "2026-03" para resetear mensual

  // Estadísticas globales
  simulacrosTotal        Int @default(0)
  preguntasRespondidas   Int @default(0)
  preguntasCorrectas     Int @default(0)

  suscripcionId String?     @unique
  suscripcion   Suscripcion? @relation(fields: [suscripcionId], references: [id])

  inscripciones UserOpec[]
  simulacros    Simulacro[]
  badges        UserBadge[]
  rankings      Ranking[]
  ligas         UserLiga[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserOpec {
  id          String      @id @default(cuid())
  userId      String
  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  opecId      String
  opec        Opec        @relation(fields: [opecId], references: [id], onDelete: Cascade)
  inscritoAt  DateTime    @default(now())
  fechaExamen DateTime?   // copia de opec.fechaExamen para plan de estudio

  @@unique([userId, opecId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────
// SIMULACRO (sesión de examen)
// ─────────────────────────────────────────────────────────

model Simulacro {
  id            String          @id @default(cuid())
  userId        String
  user          UserProfile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  opecId        String
  opec          Opec            @relation(fields: [opecId], references: [id], onDelete: Cascade)

  tipoSimulacro TipoSimulacro   @default(MIXTO)
  estado        EstadoSimulacro @default(EN_PROGRESO)

  // Resultados (se rellenan al finalizar)
  puntajeTotal      Float?
  puntajeFuncEsp    Float? // % correctas en FUNCIONAL_ESPECIFICA
  puntajeFuncTrans  Float? // % correctas en FUNCIONAL_TRANSVERSAL
  puntajeComport    Float? // Puntaje ponderado COMPORTAMENTAL
  xpGanado          Int?
  tiempoSegundos    Int?   // Duración total

  iniciadoAt   DateTime  @default(now())
  finalizadoAt DateTime?

  respuestas RespuestaUsuario[]

  @@index([userId, opecId])
  @@index([userId, estado])
}

model RespuestaUsuario {
  id          String           @id @default(cuid())
  simulacroId String
  simulacro   Simulacro        @relation(fields: [simulacroId], references: [id], onDelete: Cascade)
  preguntaId  String
  pregunta    Pregunta         @relation(fields: [preguntaId], references: [id])
  opcionId    String?
  opcion      OpcionRespuesta? @relation(fields: [opcionId], references: [id])
  valorLikert Int?             // Solo para COMPORTAMENTAL (1-5)
  esCorrecta  Boolean?
  tiempoMs    Int?             // Milisegundos en responder

  @@index([simulacroId])
  @@index([preguntaId])
}

// ─────────────────────────────────────────────────────────
// GAMIFICACIÓN
// ─────────────────────────────────────────────────────────

model Ranking {
  id        String      @id @default(cuid())
  userId    String
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  opecId    String
  opec      Opec        @relation(fields: [opecId], references: [id], onDelete: Cascade)

  xpSemanal Int      @default(0)
  xpTotal   Int      @default(0)
  posicion  Int?
  semana    DateTime // Lunes de la semana ISO

  @@unique([userId, opecId, semana])
  @@index([opecId, semana, xpSemanal(sort: Desc)])
}

model Liga {
  id      String     @id @default(cuid())
  nombre  String     @unique // Bronce, Plata, Oro, Platino, Diamante
  nivel   Int        @unique // 1-5
  xpMin   Int
  color   String     // HEX
  emoji   String

  usuarios UserLiga[]
}

model UserLiga {
  id     String      @id @default(cuid())
  userId String
  user   UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  ligaId String
  liga   Liga        @relation(fields: [ligaId], references: [id])
  semana DateTime

  @@unique([userId, semana])
  @@index([ligaId, semana])
}

model Badge {
  id          String    @id @default(cuid())
  nombre      String    @unique
  descripcion String
  icono       String    // Emoji o nombre de ícono Lucide
  tipo        TipoBadge
  umbral      Int?      // Valor numérico para la condición (ej: 7 días de racha)

  usuarios UserBadge[]
}

model UserBadge {
  id         String      @id @default(cuid())
  userId     String
  user       UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId    String
  badge      Badge       @relation(fields: [badgeId], references: [id])
  obtenidoAt DateTime    @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────
// SUSCRIPCIONES
// ─────────────────────────────────────────────────────────

/// Configuración editable de cada plan (guardada en DB, admin la puede modificar)
model PlanConfig {
  plan                  PlanSuscripcion @id
  nombre                String          // "Gratuito", "Básico", "Pro", "Premium"
  descripcion           String
  precioMensualCOP      Int             // 0 = gratis
  simulacrosMes         Int             // -1 = ilimitado
  preguntasPorSimulacro Int
  features              String[]        // Lista de beneficios visibles al usuario
  color                 String          // HEX: "#16a34a"
  emoji                 String          // "🆓" "⚡" "🚀" "💎"
  activo                Boolean         @default(true)
  updatedAt             DateTime        @updatedAt
}

model Suscripcion {
  id     String          @id @default(cuid())
  plan   PlanSuscripcion @default(GRATUITO)
  estado EstadoSuscripcion @default(ACTIVA)

  // Límites del plan
  simulacrosMes         Int // -1 = ilimitado
  preguntasPorSimulacro Int

  inicioAt DateTime  @default(now())
  finAt    DateTime?

  // Referencia de pago Wompi/PayU
  referenciaPago String?
  montoCop       Int?    // En pesos colombianos

  user UserProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────
// CONFIGURACIÓN DE LA APLICACIÓN
// ─────────────────────────────────────────────────────────

/// Pares clave-valor para configuración persit en DB (ej. SMTP)
model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────
// DOCUMENTOS — Manuales y guías oficiales por OPEC (input para IA)
// ─────────────────────────────────────────────────────────

model Document {
  id            String       @id @default(cuid())
  opecId        String
  opec          Opec         @relation(fields: [opecId], references: [id], onDelete: Cascade)

  type          DocumentType
  fileName      String
  fileSize      Int          // bytes
  parsedContent String?      @db.Text
  isParsed      Boolean      @default(false)
  parseError    String?
  ocrUsed       Boolean      @default(false)

  /// URL desde donde se descarga el PDF/imagen (ej. SIMO get-document?docId=...).
  /// null = el documento se subió manualmente y no tiene fuente externa.
  sourceUrl     String?

  uploadedAt    DateTime     @default(now())

  @@index([opecId])
  @@index([type, isParsed]) // para el cron parser que filtra docs pendientes
}

// ─────────────────────────────────────────────────────────
// CONCURSOS EN DESARROLLO — Slider/CMS de la landing
// Sincronizado a diario desde cnsc.gov.co/convocatorias/en-desarrollo
// ─────────────────────────────────────────────────────────

model ConcursoEnDesarrollo {
  id            String   @id @default(cuid())
  /// Slug derivado del path original en cnsc.gov.co (último segmento)
  slug          String   @unique
  /// Nombre tal como viene del scraper
  nombreScraped String
  /// Override editable desde el admin; si null se usa nombreScraped
  nombreOverride String?
  /// URL externa al detalle en CNSC
  linkCnsc      String
  /// Imagen custom subida por admin; si null se usa la generada con next/og
  imagenCustomUrl String?
  /// Mostrar en slider público
  visible       Boolean  @default(true)
  /// Orden manual (asc); empate → orden alfabético
  orden         Int      @default(0)

  scrapedAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([visible, orden])
}

// ─────────────────────────────────────────────────────────
// BIBLIOTECA — Recursos transversales (leyes, decretos, manuales)
// que aplican a cualquier funcionario público colombiano.
// Admin sube/asigna el PDF; los usuarios pueden descargarlo/leerlo.
// ─────────────────────────────────────────────────────────

enum BloqueBiblioteca {
  REGIMEN_SERVIDOR_PUBLICO
  DISCIPLINARIO
  INFORMACION_ARCHIVO_TRANSPARENCIA
  GESTION_CONTROL
  CONTRATACION_PRESUPUESTO_TALENTO
  ETICA_SERVICIO
}

model RecursoBiblioteca {
  id          String           @id @default(cuid())
  bloque      BloqueBiblioteca
  titulo      String           // "Carrera Administrativa"
  numeroNorma String?          // "Ley 909 de 2004"
  descripcion String?          @db.Text
  /// URL del PDF (puede ser externa o Vercel Blob después de upload)
  pdfUrl      String?
  /// Nombre del archivo (cuando se sube via Blob)
  pdfFileName String?
  /// Tamaño en bytes del PDF subido
  pdfSize     Int?
  vigente     Boolean          @default(true)
  orden       Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([bloque, vigente, orden])
}

// ─────────────────────────────────────────────────────────
// ENTIDADES DE RÉGIMEN ESPECIAL (Procuraduría, Banrep, etc.)
// Cada una con su propio sistema de convocatorias fuera de SIMO/CNSC.
// ─────────────────────────────────────────────────────────

model EntidadEspecial {
  id          String   @id @default(cuid())
  slug        String   @unique          // "procuraduria"
  nombre      String                    // "Procuraduría General de la Nación"
  descripcion String?  @db.Text
  /// URL al endpoint JSON paginado (admin la pega desde DevTools)
  apiUrl      String
  /// Página web pública para que usuarios consulten más detalles
  webUrl      String?
  /// Nombre del query param para la página (default Spring: "page")
  pageParam   String   @default("page")
  /// Nombre del query param para el tamaño (default: "size")
  sizeParam   String   @default("size")
  pageSize    Int      @default(25)
  /// Key dentro del JSON donde está el array de items
  itemsKey    String   @default("convocatorias")
  /// Key opcional con el total para saber cuántas páginas pedir
  totalKey    String   @default("totalElementos")
  activo      Boolean  @default(true)
  ultimoScrape DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  opecs       OpecEspecial[]
}

model OpecEspecial {
  id                  String   @id @default(cuid())
  entidadId           String
  entidad             EntidadEspecial @relation(fields: [entidadId], references: [id], onDelete: Cascade)
  externalId          String              // id en sistema origen
  cargo               String
  codigoConvocatoria  String
  grado               String?
  nivel               String?
  salario             Int?
  costoInscripcion    Int?
  numeroPlazas        Int      @default(0)
  totalInscritos      Int      @default(0)
  esActiva            Boolean  @default(true)
  sedes               String[]
  /// URL del PDF del manual / convocatoria (admin la edita; no viene en el JSON)
  pdfUrl              String?
  raw                 Json?     // backup del item completo
  scrapedAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([entidadId, externalId])
  @@index([entidadId, esActiva])
}
